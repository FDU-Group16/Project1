  "components": {
    "schemas": {
      "RoomCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "departmentId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "openHour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "closeHour": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "weekdays": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "name",
          "openHour",
          "closeHour",
          "weekdays"
        ]
      },
      "RoomPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "departmentId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "openHour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "closeHour": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "weekdays": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          },
