  "components": {
    "securitySchemes": {
      "userBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "候选方案，D认证载体待确认；后端验证可信身份，不接收浏览器自报角色。若采用cookie等需修订该草案并统一公共HTTP层。"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "description": "用户+动作+目标+键作用域；先重新鉴权，再回放原结果/同operation的202；同键不同规范输入409；重试不换键。"
      },
      "ApplicationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "TaskId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PageSize": {
        "name": "page_size",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Mine": {
        "name": "scope",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "mine"
          ],
          "default": "mine"
        }
      },
      "ApplicationStatusFilter": {
        "name": "status",
        "in": "query",
        "schema": {
          "$ref": "#/components/schemas/ApplicationStatus"
        }
      },
      "Pending": {
        "name": "status",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "pending"
          ],
          "default": "pending"
        }
      }
    },
    "responses": {
      "401": {
        "description": "未登录或凭证无效。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "403": {
        "description": "无权限或管理范围不足。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "404": {
        "description": "目标不存在，或按授权隐藏策略不可见。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "409": {
        "description": "状态/version/幂等输入/资源冲突；以error.code区分。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "422": {
        "description": "输入校验失败，统一ErrorResponse（含框架校验）。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "503": {
        "description": "已知依赖不可用。可能已生效的资源请求需持久化恢复，不能据503推断未占用。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "UtcTimestamp": {
        "type": "string",
        "format": "date-time",
        "pattern": "Z$",
        "description": "RFC3339 UTC，以Z结尾。拒绝无时区输入，使用半开区间。"
      },
      "ApplicationStatus": {
        "type": "string",
        "enum": [
          "PENDING_LEVEL_1",
          "PENDING_LEVEL_2",
          "RESOURCE_PENDING",
          "APPROVED",
          "REJECTED",
          "WITHDRAWN",
          "EXPIRED"
        ]
      },
      "TaskStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "PASSED",
          "REJECTED",
          "CLOSED"
        ]
      },
      "ResourcePhase": {
        "type": "string",
        "enum": [
          "NONE",
          "ACTIVATING",
          "RELEASING",
          "NEEDS_ATTENTION"
        ]
      },
      "ManagedScope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "scope_id"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "DEPARTMENT",
              "ROOM"
            ]
          },
          "scope_id": {
            "type": "string",
            "minLength": 1,
            "description": "外部不透明ID，保留D原义；不假设UUID。"
          }
        }
      },
      "ApplicationCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "room_id",
          "start_at",
          "end_at",
          "purpose",
          "attendee_count"
        ],
        "properties": {
          "room_id": {
            "type": "string",
            "minLength": 1,
            "description": "外部不透明ID，保留D原义；不假设UUID。"
          },
          "start_at": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "end_at": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S",
            "description": "服务端去首尾空白后校验；不能只包含空白。"
          },
          "attendee_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "description": "申请人和院系从可信身份取得，禁止客户端传入。end_at>start_at、未来时段、容量/开放范围/路由资格由服务端验证；政策待DEC-02/05确认。"
      },
      "ApplicationView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application_id",
          "applicant_id",
          "applicant_department_id",
          "room_id",
          "start_at",
          "end_at",
          "deadline_at",
          "created_at",
          "updated_at",
          "purpose",
          "attendee_count",
          "status",
          "version",
          "current_step",
          "termination_reason",
          "last_resource_error",
          "resource_phase"
        ],
        "properties": {
          "application_id": {
            "type": "string",
            "format": "uuid"
          },
          "applicant_id": {
            "type": "string",
            "minLength": 1,
            "description": "外部不透明ID，保留D原义；不假设UUID。"
          },
          "applicant_department_id": {
            "type": "string",
            "minLength": 1,
            "description": "外部不透明ID，保留D原义；不假设UUID。"
          },
          "room_id": {
            "type": "string",
            "minLength": 1,
            "description": "外部不透明ID，保留D原义；不假设UUID。"
          },
          "start_at": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "end_at": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "deadline_at": {
