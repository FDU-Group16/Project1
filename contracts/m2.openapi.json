{
  "openapi": "3.1.0",
  "info": {
    "title": "M2 申请与审批公开接口（草案）",
    "version": "0.1.0-proposed",
    "description": "A0-01评审草案，尚未实现/注册/评审。A维护共同契约，B评审审批操作。DEC-02～09政策与认证/错误方案待确认。Bearer仅为候选认证载体，未承诺D实现；正式代码必须依据最终D契约。所有时间UTC Z；区间[start,end)。写请求先重新鉴权再按用户+动作+目标+键处理幂等；原输入重放原结果，同键异输入409，处理中同一operation_id。"
  },
  "x-contract-status": "proposed",
  "x-runtime-implemented": false,
  "x-decision-record": "services/m2/docs/decisions/A0-01-proposals.md",
  "security": [
    {
      "userBearer": []
    }
  ],
  "tags": [
    {
      "name": "A",
      "description": "申请与资源对接"
    },
    {
      "name": "B",
      "description": "审批与超时处理；仅契约草案，不是B实现"
    }
  ],
  "paths": {
