    "/api/m2/approval-tasks/{id}/approve": {
      "post": {
        "operationId": "approveTask",
        "summary": "通过当前审批",
        "tags": [
          "B"
        ],
        "x-owner": "B",
        "description": "禁止跳级、自批、越权、过期和终态操作；一级通过仅入二级；二级须匹配M1确认且确认事务未截止才批准。未知资源结果持久化并202。",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
