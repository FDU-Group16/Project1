# Public API proxies; internal service endpoints are never forwarded.
M1_PROXY_TARGET=http://127.0.0.1:3101
D_PROXY_TARGET=http://127.0.0.1:3104
M3_PROXY_TARGET=http://127.0.0.1:3103

# TEMPORARY-DEPENDENCY WEB-D01-IDENTITY：Web M1/D-02 消费 D-01（M2 组）的显式开发替身开关。
# 提供/消费组可在集成范围内调整或移除此开关；真实联调通过后按清单清理，保留真实 API 代理配置。
# 修改边界见 src/shared/auth/docs/auth-integration.md；本示例默认关闭，不表示真实身份已接入。
# Production builds always disable this, even when true.
# Each backend must separately opt into its own development identity mode.
VITE_USE_DEV_IDENTITY=false
